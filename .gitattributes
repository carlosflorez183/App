# Normaliza los finales de línea en el repositorio.
# Los archivos se guardan con LF aunque el editor use CRLF en Windows,
# evitando diffs de miles de líneas por el salto de línea.
* text=auto eol=lf

# Binarios: nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.xlsx binary
