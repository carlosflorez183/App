# Copia este archivo a `.env` y ajusta los valores.
# Docker Compose lo lee automáticamente en la raíz del proyecto.

# --- PostgreSQL ---
DB_PASSWORD=uni_dev_password

# Firma de los tokens de sesión. Genera una propia con: openssl rand -hex 64
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Intentos de login por cuenta antes del 429. En producción usa 5.
RATE_LIMIT_LOGIN_MAX=30

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
